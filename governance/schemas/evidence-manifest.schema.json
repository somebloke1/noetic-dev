{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Manifest Schema",
  "description": "Authoritative evidence manifest for noetic-dev delivery governance. Manifests are generated by protected policy code outside the candidate checkout.",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "run_id",
    "generated_at",
    "policy",
    "repo",
    "issue",
    "pull_request",
    "passes",
    "qa",
    "commands",
    "validations",
    "tests",
    "state_transitions",
    "approvals",
    "publication"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "generated_at": {"type": "string", "format": "date-time"},
    "policy": {
      "type": "object",
      "required": ["ref", "sha", "generator_path", "generator_sha256", "trusted_runner"],
      "properties": {
        "ref": {"type": "string"},
        "sha": {"type": "string", "minLength": 40, "maxLength": 40},
        "generator_path": {"type": "string"},
        "generator_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "trusted_runner": {"type": "boolean"},
        "runner_attestation": {
          "type": "object",
          "properties": {
            "artifact": {
              "type": "object",
              "properties": {
                "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              },
              "required": ["manifest_sha256"]
            }
          }
        }
      }
    },
    "repo": {
      "type": "object",
      "required": ["remote", "base_branch", "base_sha", "candidate_branch", "candidate_sha", "candidate_tree_oid"],
      "properties": {
        "remote": {"type": "string"},
        "base_branch": {"type": "string"},
        "base_sha": {"type": "string", "minLength": 40, "maxLength": 40},
        "candidate_branch": {"type": "string"},
        "candidate_sha": {"type": "string", "minLength": 40, "maxLength": 40},
        "candidate_tree_oid": {"type": "string", "minLength": 40, "maxLength": 40}
      }
    },
    "issue": {
      "type": "object",
      "required": ["numbers", "labels", "canonical_status"],
      "properties": {
        "numbers": {"type": "array", "items": {"type": "integer"}},
        "labels": {"type": "array", "items": {"type": "string"}},
        "canonical_status": {"type": "string", "pattern": "^status:.*$"}
      }
    },
    "pull_request": {
      "type": "object",
      "required": ["number", "title", "author", "draft_state", "base", "head_sha", "linked_issues"],
      "properties": {
        "number": {"type": "integer"},
        "title": {"type": "string"},
        "author": {"type": "string"},
        "draft_state": {"type": "boolean"},
        "base": {"type": "string"},
        "head_sha": {"type": "string", "minLength": 40, "maxLength": 40},
        "linked_issues": {"type": "array", "items": {"type": "integer"}}
      }
    },
    "passes": {
      "type": "object",
      "required": ["implementation_pass_ids", "remediation_pass_ids", "parent_pass_id", "candidate_sha", "ordering"],
      "properties": {
        "implementation_pass_ids": {"type": "array", "items": {"type": "string"}},
        "remediation_pass_ids": {"type": "array", "items": {"type": "string"}},
        "parent_pass_id": {"type": "string"},
        "candidate_sha": {"type": "string", "minLength": 40, "maxLength": 40},
        "ordering": {"type": "array", "items": {"type": "string"}}
      }
    },
    "qa": {
      "type": "object",
      "required": ["qa_for_pass_id", "model_profile", "verdict", "report_hash", "event_log_hash", "isolation_proof"],
      "properties": {
        "qa_for_pass_id": {"type": "string"},
        "model_profile": {"type": "string"},
        "verdict": {"type": "string", "enum": ["pass", "fail"]},
        "report_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "event_log_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "isolation_proof": {
          "type": "object",
          "required": ["source_mount_read_only", "scratch_separate_from_source", "candidate_tree_before", "candidate_tree_after", "write_tools_observed"],
          "properties": {
            "source_mount_read_only": {"type": "boolean"},
            "scratch_separate_from_source": {"type": "boolean"},
            "host_home_mounted": {"type": "boolean"},
            "ssh_config_mounted": {"type": "boolean"},
            "gh_config_mounted": {"type": "boolean"},
            "ambient_credentials_available": {"type": "boolean"},
            "context_files_disabled": {"type": "boolean"},
            "extensions_disabled": {"type": "boolean"},
            "skills_disabled": {"type": "boolean"},
            "themes_disabled": {"type": "boolean"},
            "candidate_tree_before": {"type": "string", "minLength": 40, "maxLength": 40},
            "candidate_tree_after": {"type": "string", "minLength": 40, "maxLength": 40},
            "write_tools_observed": {"type": "boolean"}
          }
        },
        "protected_execution_record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command_id", "category", "argv", "cwd", "exit_code", "stdout_sha256", "stderr_sha256"],
        "properties": {
          "command_id": {"type": "string"},
          "category": {"type": "string", "enum": ["validation", "test", "gate"]},
          "argv": {"type": "array", "items": {"type": "string"}},
          "cwd": {"type": "string"},
          "exit_code": {"type": "integer"},
          "stdout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "stderr_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "validations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tests": {
      "type": "array",
      "items": {"type": "string"}
    },
    "state_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "authority", "timestamp"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "authority": {"type": "string"},
          "timestamp": {"type": "string", "format": "date-time"}
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewer", "commit_sha", "timestamp", "independent"],
        "properties": {
          "reviewer": {"type": "string"},
          "commit_sha": {"type": "string", "minLength": 40, "maxLength": 40},
          "timestamp": {"type": "string", "format": "date-time"},
          "independent": {"type": "boolean"}
        }
      }
    },
    "publication": {
      "type": "object",
      "required": ["merge_result_sha", "publication_sha"],
      "properties": {
        "merge_result_sha": {"type": "string", "minLength": 40, "maxLength": 40},
        "publication_sha": {"type": "string", "minLength": 40, "maxLength": 40},
        "tag_sha": {"type": "string"},
        "deploy_sha": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"policy": {"properties": {"trusted_runner": {"const": true}}}}
      },
      "then": {
        "required": ["policy", "repo", "qa"]
      }
    }
  ]
}
