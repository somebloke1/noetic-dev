{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Noetic-dev Roadmap State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "document_path",
    "authority_issue",
    "baseline",
    "stages",
    "parallel_tracks",
    "unresolved_conflicts"
  ],
  "properties": {
    "$schema": {"type": "string", "const": "./schemas/roadmap.schema.json"},
    "schema_version": {"type": "string", "const": "1"},
    "document_path": {"type": "string", "const": "ROADMAP.md"},
    "authority_issue": {"type": "integer", "const": 32},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "sha", "captured_at", "claim_scope"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "captured_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "claim_scope": {"type": "string", "const": "integration_checkpoint_only"}
      }
    },
    "stages": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"$ref": "#/definitions/stage"}
    },
    "parallel_tracks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/definitions/parallel_track"}
    },
    "unresolved_conflicts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/definitions/conflict"}
    }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["commit", "issue", "pull_request", "workflow_run", "artifact"]
        },
        "reference": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "commit"}}},
          "then": {"properties": {"reference": {"pattern": "^[0-9a-f]{40}$"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "issue"}}},
          "then": {
            "properties": {
              "reference": {
                "pattern": "^https://github\\.com/somebloke1/noetic-dev/issues/[1-9][0-9]*$"
              }
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "pull_request"}}},
          "then": {
            "properties": {
              "reference": {
                "pattern": "^https://github\\.com/somebloke1/noetic-dev/pull/[1-9][0-9]*$"
              }
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "workflow_run"}}},
          "then": {
            "properties": {
              "reference": {
                "pattern": "^https://github\\.com/somebloke1/noetic-dev/actions/runs/[1-9][0-9]*$"
              }
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "artifact"}}},
          "then": {
            "properties": {
              "reference": {
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              }
            }
          }
        }
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "depends_on", "exit_gate", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "D0", "D1a", "D1b", "D2", "D3a", "D3b", "D4a", "D4b",
            "D4c", "D4d", "D5", "D6", "D7", "D8", "D9"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": ["checkpointed", "next", "planned", "blocked"]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "D0", "D1a", "D1b", "D2", "D3a", "D3b", "D4a", "D4b",
              "D4c", "D4d", "D5", "D6", "D7", "D8", "D9"
            ]
          }
        },
        "exit_gate": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/definitions/evidence"}
        }
      }
    },
    "parallel_track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "constraint"],
      "properties": {
        "id": {"type": "string", "enum": ["T1", "T2", "T3", "T4"]},
        "title": {"type": "string", "minLength": 1},
        "constraint": {"type": "string", "minLength": 1}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "resolution_stage", "blocks"],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["C1", "C2", "C3", "C4", "C5", "C6", "C7", "C8"]
        },
        "title": {"type": "string", "minLength": 1},
        "resolution_stage": {
          "type": "string",
          "enum": [
            "D0", "D1a", "D1b", "D2", "D3a", "D3b", "D4a", "D4b",
            "D4c", "D4d", "D5", "D6", "D7", "D8", "D9"
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "D0", "D1a", "D1b", "D2", "D3a", "D3b", "D4a", "D4b",
              "D4c", "D4d", "D5", "D6", "D7", "D8", "D9"
            ]
          }
        }
      }
    }
  }
}
