{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Existing Work Freeze Schema",
  "type": "object",
  "required": ["schema_version", "status", "known_open_pr_count", "blocks_publication", "blocks_new_pr_opening_claims", "audit_required", "audit_completed", "audit_artifact", "audit_sha256", "captured_at", "review_gate", "independent_review_completed", "authorized_repair", "publication_gate"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "status": {"type": "string", "enum": ["active", "repair_authorized", "complete"]},
    "reason": {"type": "string"},
    "known_open_pr_count": {"type": "integer"},
    "blocks_publication": {"type": "boolean"},
    "blocks_new_pr_opening_claims": {"type": "boolean"},
    "audit_required": {"type": "boolean"},
    "audit_completed": {"type": "boolean"},
    "publication_gate": {"type": "string"},
    "audit_artifact": {"type": "string"},
    "audit_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "captured_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
    "review_gate": {"type": "string"},
    "independent_review_completed": {"type": "boolean"},
    "reviewed_candidate_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "reviewed_pull_request": {"type": "integer", "minimum": 1},
    "dev_integration_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "reviewed_at": {"type": "string", "minLength": 1},
    "review_evidence_url": {"type": "string", "pattern": "^https://github\\.com/somebloke1/noetic-dev/(?:issues/32|pull/[1-9][0-9]*)#issuecomment-[1-9][0-9]*$"},
    "authorized_repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "head", "base", "max_pull_requests"],
      "properties": {
        "issue": {"type": "integer", "const": 32},
        "head": {"type": "string", "const": "issue-32-canonical-roadmap"},
        "base": {"type": "string", "const": "dev"},
        "max_pull_requests": {"type": "integer", "const": 1}
      }
    }
  }
}
