{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Future External Protected Delivery Evidence Interface Schema",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_class",
    "mode",
    "verification_status",
    "repository",
    "workflow",
    "run",
    "job",
    "pull_request",
    "artifact",
    "protected_ref",
    "checkouts",
    "generator",
    "policy_file_hashes_source",
    "policy_file_hashes",
    "branch_protection",
    "approvals",
    "freeze"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "evidence_class": {"type": "string", "const": "protected-external"},
    "mode": {"type": "string", "enum": ["github_api", "github_artifact_attestation"]},
    "verification_status": {"type": "string", "const": "verified", "description": "Advisory until captured or attested by a separately protected required integration."},
    "repository": {"type": "object"},
    "workflow": {"type": "object"},
    "run": {"type": "object"},
    "job": {"type": "object"},
    "pull_request": {"type": "object"},
    "artifact": {"type": "object"},
    "protected_ref": {"type": "object"},
    "checkouts": {"type": "object"},
    "generator": {"type": "object"},
    "policy_file_hashes_source": {"type": "string"},
    "policy_file_hashes": {"type": "object"},
    "branch_protection": {"type": "object"},
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewer", "commit_sha", "submitted_at", "state", "model_profile", "reasoning_level"],
        "properties": {
          "reviewer": {"type": "string", "minLength": 1},
          "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "submitted_at": {"type": "string", "minLength": 1},
          "state": {"type": "string", "const": "APPROVED"},
          "model_profile": {"type": "string", "enum": ["reviewer_fable", "reviewer_sol"]},
          "reasoning_level": {"type": "string", "enum": ["high", "xhigh", "max"]}
        },
        "additionalProperties": true
      }
    },
    "freeze": {"type": "object"},
    "signed_attestation": {"type": "object"},
    "post_merge": {"type": "object"}
  }
}
