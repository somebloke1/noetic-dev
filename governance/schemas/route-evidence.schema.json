{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Protected Routed Model Evidence Schema",
  "type": "object",
  "required": ["schema_version", "classification", "attempts"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "classification": {
      "type": "object",
      "required": ["task_kind", "complexity", "blast_radius", "high_value", "awaited"],
      "properties": {
        "task_kind": {"type": "string"},
        "complexity": {"type": "string"},
        "blast_radius": {"type": "string"},
        "high_value": {"type": "boolean"},
        "awaited": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["decision", "outcome", "outcome_recorded", "reasoning_effort"],
        "properties": {
          "decision": {"type": "object"},
          "outcome": {"type": "string", "enum": ["success", "failure"]},
          "outcome_recorded": {"type": "boolean", "const": true},
          "reasoning_effort": {"type": "string", "const": "high"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
