{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Command Registry Schema",
  "type": "object",
  "required": ["schema_version", "commands", "rules"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "description": {"type": "string"},
    "commands": {
      "type": "object"
    },
    "rules": {"type": "object"}
  }
}
