{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Delivery State Machine Schema",
  "type": "object",
  "required": ["schema_version", "states", "transitions", "role_authorities"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "description": {"type": "string"},
    "states": {"type": "object"},
    "transitions": {"type": "array", "items": {"type": "object"}},
    "role_authorities": {"type": "object"}
  }
}
