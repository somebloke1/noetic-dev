{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Protected QA Probe Record Schema",
  "type": "object",
  "required": [
    "schema_version",
    "probe_id",
    "run_id",
    "role_run_id",
    "authority_process",
    "authority_worker_pid",
    "route_evidence",
    "invoked_model_ref",
    "reasoning_effort",
    "pi_version",
    "policy_commit_sha",
    "candidate_sha",
    "base_sha",
    "candidate_tree_oid",
    "tools",
    "environment_name_allowlist",
    "context_files_disabled",
    "extensions_disabled",
    "skills_disabled",
    "themes_disabled",
    "probe_argv",
    "probe_argv_sha256",
    "probe_prompt_hash",
    "probe_event_log_sha256",
    "final_assistant_text_sha256",
    "model_config_sha256",
    "model_config_delivery",
    "nonce",
    "expected_response",
    "observed_response",
    "exit_code",
    "stdout_sha256",
    "stderr_sha256",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "2"},
    "probe_id": {"type": "string"},
    "run_id": {"type": "string"},
    "role_run_id": {"type": "string"},
    "authority_process": {"type": "string", "const": "fresh-isolated-worker"},
    "authority_worker_pid": {"type": "integer", "minimum": 1},
    "route_evidence": {"type": "object"},
    "invoked_model_ref": {"type": "object"},
    "reasoning_effort": {"type": "string", "const": "high"},
    "resolved_model": {"type": "string"},
    "profile_id": {"type": "string"},
    "profile_hash": {"type": "string"},
    "pi_version": {"type": "string"},
    "policy_commit_sha": {"type": "string"},
    "candidate_sha": {"type": "string"},
    "base_sha": {"type": "string"},
    "candidate_tree_oid": {"type": "string"},
    "tools": {"type": "array", "items": {"type": "string"}},
    "environment_name_allowlist": {"type": "array", "items": {"type": "string"}},
    "context_files_disabled": {"type": "boolean"},
    "extensions_disabled": {"type": "boolean"},
    "skills_disabled": {"type": "boolean"},
    "themes_disabled": {"type": "boolean"},
    "probe_argv": {"type": "array", "items": {"type": "string"}},
    "probe_argv_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "probe_prompt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "probe_event_log_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "final_assistant_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_config_delivery": {"type": "string", "const": "inherited-fd-copy"},
    "nonce": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "expected_response": {"type": "string", "pattern": "^READY [a-f0-9]{16}$"},
    "observed_response": {"type": "string", "pattern": "^READY [a-f0-9]{16}$"},
    "exit_code": {"type": "integer"},
    "stdout_sha256": {"type": "string"},
    "stderr_sha256": {"type": "string"},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"}
  }
}
