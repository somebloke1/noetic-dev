{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Protected QA Execution Record Schema",
  "type": "object",
  "required": ["schema_version", "record_id", "run_id", "role", "role_run_id", "qa_for_pass_id", "generated_by", "actual_invocation"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "record_id": {"type": "string"},
    "run_id": {"type": "string"},
    "role": {"type": "string", "const": "qa"},
    "role_run_id": {"type": "string"},
    "qa_for_pass_id": {"type": "string"},
    "evidence_class": {"type": "string"},
    "record_only": {"type": "boolean"},
    "generated_by": {"type": "object"},
    "actual_invocation": {"type": "object"}
  }
}
