{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Protected QA Execution Record Schema",
  "type": "object",
  "required": ["schema_version", "record_id", "run_id", "role", "role_run_id", "qa_for_pass_id", "generated_by", "actual_invocation"],
  "properties": {
    "schema_version": {"type": "string", "const": "2"},
    "record_id": {"type": "string"},
    "run_id": {"type": "string"},
    "role": {"type": "string", "const": "qa"},
    "role_run_id": {"type": "string"},
    "qa_for_pass_id": {"type": "string"},
    "evidence_class": {"type": "string"},
    "record_only": {"type": "boolean"},
    "generated_by": {
      "type": "object",
      "required": ["policy_commit_sha", "dispatcher_path", "dispatcher_sha256"],
      "properties": {
        "policy_commit_sha": {"type": "string"},
        "dispatcher_path": {"type": "string"},
        "dispatcher_sha256": {"type": "string"}
      }
    },
    "actual_invocation": {
      "type": "object",
      "required": [
        "route_evidence",
        "invoked_model_ref",
        "reasoning_effort",
        "pi_version",
        "authority_process",
        "authority_worker_pid",
        "operation",
        "operation_contract",
        "attempt_accounting",
        "argv",
        "argv_sha256",
        "prompt_text",
        "prompt_sha256",
        "final_assistant_text",
        "final_assistant_text_sha256",
        "qa_event_log",
        "model_config_sha256",
        "model_config_delivery",
        "tools",
        "environment_name_allowlist",
        "environment_values_recorded",
        "candidate_sha",
        "candidate_tree_oid",
        "policy_commit_sha",
        "started_at",
        "finished_at",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "qa_event_log_sha256",
        "isolation"
      ],
      "properties": {
        "route_evidence": {"type": "object"},
        "invoked_model_ref": {"type": "object"},
        "reasoning_effort": {"type": "string", "const": "high"},
        "resolved_model": {"type": "string"},
        "profile_id": {"type": "string"},
        "profile_hash": {"type": "string"},
        "pi_version": {"type": "string"},
        "authority_process": {"type": "string", "const": "fresh-isolated-worker"},
        "authority_worker_pid": {"type": "integer", "minimum": 1},
        "operation": {"type": "string", "const": "execution"},
        "operation_contract": {"type": "object"},
        "attempt_accounting": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "argv": {"type": "array", "items": {"type": "string"}},
        "argv_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "prompt_text": {"type": "string", "minLength": 1, "maxLength": 300000},
        "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "final_assistant_text": {"type": "string", "minLength": 1, "maxLength": 65536},
        "final_assistant_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "qa_event_log": {"type": "string", "minLength": 1, "maxLength": 1048576},
        "model_config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "model_config_delivery": {"type": "string", "const": "inherited-fd-copy"},
        "tools": {"type": "array", "items": {"type": "string"}},
        "environment_name_allowlist": {"type": "array", "items": {"type": "string"}},
        "environment_values_recorded": {"type": "boolean"},
        "candidate_sha": {"type": "string"},
        "base_sha": {"type": "string"},
        "candidate_tree_oid": {"type": "string"},
        "policy_commit_sha": {"type": "string"},
        "started_at": {"type": "string"},
        "finished_at": {"type": "string"},
        "exit_code": {"type": "integer"},
        "stdout_sha256": {"type": "string"},
        "stderr_sha256": {"type": "string"},
        "qa_event_log_sha256": {"type": "string"},
        "isolation": {"type": "object"},
        "credential_interface": {"type": "object"}
      }
    }
  }
}
