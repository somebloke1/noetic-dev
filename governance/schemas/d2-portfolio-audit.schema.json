{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "D2 Portfolio Audit Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "captured_at", "sources", "refs", "counts", "open_pull_requests", "branches", "open_issues", "review"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "repository": {"type": "string", "const": "somebloke1/noetic-dev"},
    "captured_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main", "dev", "default_branch", "dev_ahead_of_main"],
      "properties": {
        "main": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "dev": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "default_branch": {"type": "string", "const": "dev"},
        "dev_ahead_of_main": {"type": "integer", "minimum": 0}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_pull_requests", "branches", "open_issues"],
      "properties": {
        "open_pull_requests": {"type": "integer", "const": 12},
        "branches": {"type": "integer", "const": 26},
        "open_issues": {"type": "integer", "const": 20}
      }
    },
    "open_pull_requests": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "title", "base", "head", "head_sha", "updated_at", "url", "disposition"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "base": {"type": "string", "minLength": 1},
          "head": {"type": "string", "minLength": 1},
          "head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "updated_at": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://github\\.com/somebloke1/noetic-dev/pull/[1-9][0-9]*$"},
          "disposition": {"type": "string", "minLength": 1}
        }
      }
    },
    "branches": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha", "disposition"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "protected": {"type": "boolean"},
          "disposition": {"type": "string", "minLength": 1}
        }
      }
    },
    "open_issues": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "title", "labels", "status", "dependencies", "updated_at", "url"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "labels": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "status": {"type": "string", "enum": ["in_progress", "blocked", "missing"]},
          "dependencies": {
            "type": "object",
            "additionalProperties": false,
            "required": ["blocked_by", "blocking"],
            "properties": {
              "blocked_by": {"type": "integer", "minimum": 0},
              "blocking": {"type": "integer", "minimum": 0}
            }
          },
          "updated_at": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://github\\.com/somebloke1/noetic-dev/issues/[1-9][0-9]*$"}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "evidence_location", "required_before_push_or_pr"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "evidence_location": {"type": "string", "minLength": 1},
        "required_before_push_or_pr": {"type": "boolean", "const": true}
      }
    }
  }
}
