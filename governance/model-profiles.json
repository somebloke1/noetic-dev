{
  "$schema": "./schemas/model-profiles.schema.json",
  "schema_version": "1",
  "description": "Legacy static profiles retained only for schema-v1 evidence compatibility. They are not runtime model selectors; new invocation is disabled until route evidence migration is complete.",
  "runtime_selection": "forbidden",
  "profiles": {
    "orchestrator": {
      "designation": "Orchestrator",
      "model_id": "openai-codex/gpt-5.6-sol",
      "verified": true,
      "ready_probe_required": true,
      "reasoning_level": "high",
      "notes": "Coordinates planning, review waves, remediation dispatch, and delegated decisions."
    },
    "reviewer_fable": {
      "designation": "Independent PR Reviewer",
      "model_id": "litellm/claude-fable-5",
      "verified": true,
      "ready_probe_required": true,
      "reasoning_level": "high",
      "notes": "Read-only semantic review and delegated approval authority for an immutable PR snapshot. Must be independent of implementation and QA identities."
    },
    "reviewer_sol": {
      "designation": "Independent PR Reviewer (alternate)",
      "model_id": "litellm/codex/gpt-5.6-sol",
      "verified": false,
      "ready_probe_required": true,
      "reasoning_level": "high",
      "notes": "Authorized alternate reviewer, currently unavailable: the 2026-07-13 high-reasoning LiteLLM READY probe returned HTTP 403. Re-enable only after a fresh successful probe."
    },
    "planner": {
      "designation": "Planner",
      "model_id": "openai-codex/gpt-5.5",
      "verified": true,
      "ready_probe_required": true,
      "notes": "Produces planning artifacts. Read-only."
    },
    "implementer_candidate": {
      "designation": "Implementer",
      "model_id": "litellm/deepseek-v4-flash",
      "verified": true,
      "ready_probe_required": true,
      "notes": "Implements plans as candidate commits."
    },
    "remediator": {
      "designation": "Remediator",
      "model_id": "openai-codex/gpt-5.5",
      "verified": true,
      "ready_probe_required": true,
      "notes": "Fixes defects found by QA. Same constraints as implementer."
    },
    "qa_primary": {
      "designation": "Primary QA",
      "model_id": "openai-codex/gpt-5.6-terra",
      "verified": true,
      "ready_probe_required": true,
      "notes": "Exactly one adversarial QA pass per implementation/remediation generation. Read-only source mount."
    },
    "qa_advisory_evaluator": {
      "designation": "Secondary Advisory Evaluator",
      "model_id": "litellm/deepseek-v4-pro",
      "verified": true,
      "ready_probe_required": true,
      "notes": "Advisory only. Must not count as the single required QA pass unless later reclassified by governance."
    },
    "publisher_dry_run": {
      "designation": "Publisher (dry-run / profile)",
      "model_id": "openai-codex/gpt-5.4-mini",
      "verified": true,
      "ready_probe_required": true,
      "notes": "Dry-run and profile only. Actual publication requires independent high-reasoning agent review approval."
    },
    "publisher_alternate_dry_run": {
      "designation": "Publisher (alternate dry-run)",
      "model_id": "litellm/minimax-m3",
      "verified": true,
      "ready_probe_required": true,
      "notes": "Alternate dry-run only."
    }
  },
  "disallowed_until_reprobed": [
    {
      "model_id": "litellm/codex/gpt-5.6-sol",
      "reason": "Authorized for delegated review but unavailable: high-reasoning READY probe returned HTTP 403 on 2026-07-13."
    },
    {
      "model_id": "openai-codex/gpt-5.6-terra-pro",
      "reason": "Removed pending re-probe and re-adjudication."
    },
    {
      "model_id": "litellm/codex/gpt-5.6-terra-pro",
      "reason": "Removed pending re-probe and re-adjudication."
    },
    {
      "model_id": "deepseek/deepseek-v4-pro",
      "reason": "Removed pending re-probe and re-adjudication."
    },
    {
      "model_id": "deepseek/deepseek-v4-flash",
      "reason": "Removed pending re-probe and re-adjudication. Note: litellm/deepseek-v4-flash is verified for implementer."
    }
  ],
  "requirements": {
    "ready_probe": {
      "description": "Every model invocation must be preceded by a fresh READY probe within the same run.",
      "nonce_length": 16,
      "expected_response_prefix": "READY ",
      "probe_alignment_fields": [
        "run_id",
        "role_run_id",
        "resolved_model",
        "profile_id",
        "profile_hash",
        "pi_version",
        "policy_commit_sha",
        "candidate_sha",
        "candidate_tree_oid",
        "tools",
        "environment_name_allowlist",
        "context_files_disabled",
        "extensions_disabled",
        "skills_disabled",
        "themes_disabled"
      ],
      "permitted_differences_from_probe": [
        "prompt_path",
        "prompt_hash",
        "event_log_hash",
        "stdout_sha256",
        "stderr_sha256",
        "started_at",
        "finished_at"
      ]
    }
  }
}
