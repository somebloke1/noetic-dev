{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/somebloke1/noetic-dev/spec/telos/v0/delegation-result.schema.json",
  "title": "noetic-dev Telos delegation result v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_id", "delegation_id", "run_id", "delegation_contract_digest",
    "status", "summary", "evidence_refs", "interaction_ref", "controller_final_event_id",
    "idempotency_key", "reported_at"
  ],
  "properties": {
    "schema_version": {"const": "telos.delegation-result/v0"},
    "result_id": {"type": "string", "pattern": "^dlgr_[a-z0-9][a-z0-9_-]{7,127}$"},
    "delegation_id": {"type": "string", "pattern": "^dlg_[a-z0-9][a-z0-9_-]{7,127}$"},
    "run_id": {"type": "string", "minLength": 1},
    "delegation_contract_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "status": {"enum": ["succeeded", "failed", "cancelled", "expired", "requires_decision"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "evidence_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "interaction_ref": {"type": ["string", "null"]},
    "controller_final_event_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 256},
    "reported_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "requires_decision"}}},
      "then": {"properties": {"interaction_ref": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["succeeded", "failed", "cancelled", "expired"]}}},
      "then": {"properties": {"controller_final_event_id": {"type": "string", "minLength": 1}}}
    }
  ]
}
