{
  "schema_version": "development.verified-change.terminal-observability.contract/v1",
  "input_projection_version": "development.verified-change.projection/v1",
  "read_model_version": "development.verified-change.terminal-observability/v1",
  "program_id": "development.verified-change",
  "program_version": "v1",
  "input_precondition": "The in-memory input was already accepted upstream by development_verified_change.validate_and_project(packet, source_trace); the observer does not authenticate this precondition.",
  "top_level_fields": [
    "schema_version",
    "scope",
    "subject",
    "evidence",
    "qa",
    "remediation",
    "controller",
    "telos",
    "explicit_unknowns"
  ],
  "scope": {
    "view_kind": "terminal_projection",
    "claim_boundary": "structural_or_source_attributed_only",
    "live_operational_data": "not_present",
    "input_provenance": "upstream_precondition_not_authenticated"
  },
  "subject_fields": [
    "program_id",
    "program_version",
    "program_instance_id",
    "execution_profile",
    "projection_state",
    "governing_purpose_id",
    "source"
  ],
  "source_subject_fields": [
    "trace_version",
    "trace_digest",
    "projection_version",
    "projection_state",
    "binding"
  ],
  "evidence_fields": [
    "attention",
    "insight",
    "procedure",
    "final_implementation",
    "lineage"
  ],
  "evidence_statuses": {
    "attention": "opaque_fixture_attributed_product",
    "insight": "opaque_fixture_attributed_product",
    "procedure": "opaque_fixture_attributed_procedure",
    "final_implementation": "opaque_fixture_attributed_candidate_reference"
  },
  "lineage_fields": [
    "attention_to_insight",
    "procedure_to_implementation",
    "final_implementation_binding"
  ],
  "qa_fields": [
    "generation_history",
    "terminal_verification"
  ],
  "telos_fields": [
    "delegation",
    "adjudication"
  ],
  "telos_delegation_wrapper": {
    "kind": "attributed_semantic",
    "attribution": "source_trace",
    "value": "unchanged source_trace_projection.delegation"
  },
  "supported_profiles": {
    "m0-direct-pass": {
      "source_trace_version": "noetic.m0.telos-adjudication-trace/v0",
      "source_projection_version": "noetic.m0.telos-adjudication-projection/v0",
      "binding_fields": [
        "correlation_id",
        "delegation_digest",
        "delegation_id",
        "generation",
        "goal_chain_id",
        "program_id",
        "run_id",
        "sub_goal_id"
      ],
      "qa_normalization": "one history item assembled from accepted_generation and qa_adjudication with accepted_generation.generation copied to the item generation",
      "remediation": {
        "represented": false
      },
      "controller_result_fields": [
        "actor_id",
        "event_id",
        "evidence_event_ids",
        "result_id",
        "run_outcome"
      ],
      "telos_adjudication_fields": [
        "actor_id",
        "disposition",
        "event_id",
        "evidence_event_ids",
        "result_id"
      ]
    },
    "m1-bounded-remediation": {
      "source_trace_version": "noetic.m1.telos-recoverability-trace/v0",
      "source_projection_version": "noetic.m1.telos-recoverability-projection/v0",
      "binding_fields": [
        "correlation_id",
        "delegation_digest",
        "delegation_id",
        "goal_chain_id",
        "program_id",
        "run_id",
        "sub_goal_id"
      ],
      "qa_normalization": "unchanged copy of the two exact source generation_history items",
      "remediation_fields": [
        "represented",
        "kind",
        "attribution",
        "remediation_budget",
        "remediation_generation"
      ],
      "controller_result_fields": [
        "accepted_event_id",
        "actor_id",
        "candidate_digest",
        "candidate_id",
        "event_id",
        "evidence_event_ids",
        "generation",
        "qa_event_id",
        "result_id",
        "run_outcome",
        "success_event_id",
        "verification_obligation_id"
      ],
      "telos_adjudication_fields": [
        "actor_id",
        "disposition",
        "event_id",
        "evidence_event_ids",
        "generation",
        "result_event_id",
        "result_id"
      ]
    }
  },
  "compatibility_guard": {
    "requires": [
      "exact terminal root shape",
      "exact consumed nested closed shapes",
      "program schema_version, program_id, program_version, and telos_adjudicated state",
      "profile exactly m0-direct-pass or m1-bounded-remediation",
      "profile-compatible source trace and source projection versions",
      "profile-compatible source projection shape and telos_adjudicated state",
      "deterministic and structurally_bound or source_equal gate markers",
      "attributed_semantic and source_trace gate markers",
      "types required to select and copy consumed values"
    ],
    "does_not_require_or_judge": [
      "authentic upstream provenance",
      "packet or source trace validity",
      "identifier or digest format, equality, or distinctness",
      "digest recomputation",
      "event order or cardinality",
      "evidence order",
      "remediation arithmetic",
      "QA conclusion",
      "controller outcome",
      "Telos disposition",
      "cross-field or source equality"
    ]
  },
  "preserved_references_only": [
    "named event IDs selected from the accepted projection",
    "named evidence event ID arrays selected from the accepted projection",
    "opaque evidence, candidate, finding, result, obligation, and digest references selected from the accepted projection"
  ],
  "explicit_unknowns": [
    "artifact_availability_and_content",
    "semantic_correctness",
    "authenticated_actor_identity",
    "genuinely_independent_qa",
    "live_runtime_state",
    "readiness_blockage_or_critical_path",
    "current_command_authority",
    "external_effect_execution",
    "causality_not_preserved_in_projection"
  ],
  "forbidden_inferences_or_additions": [
    "raw event types or timestamps",
    "immediate caused_by edges or a causal graph",
    "artifact content or dereference locations",
    "authenticated provenance or actor identity",
    "semantic correctness or evidence sufficiency",
    "genuinely independent QA",
    "ready, blocked, current, or live status",
    "critical path, dependencies, queue, duration, freshness, health, or progress",
    "actions, recommendations, commands, approval, retry, remediation advice, steering, or dispatch",
    "external effect execution"
  ],
  "pure_function": {
    "name": "derive_terminal_observability",
    "argument": "one already-produced parsed projection object",
    "result": "fresh dict",
    "forbidden_dependencies": [
      "program reducer",
      "M0 reducer",
      "M1 reducer",
      "digest implementation",
      "files",
      "environment",
      "clock",
      "randomness",
      "processes",
      "Git",
      "providers",
      "models",
      "network",
      "MCP",
      "database",
      "controller",
      "scheduler",
      "writes"
    ]
  },
  "cli": {
    "input_paths": 1,
    "check_additional_paths": 1,
    "output_encoding": "ASCII",
    "output_key_order": "lexicographic",
    "output_indentation_spaces": 2,
    "output_line_termination": "one final LF",
    "validation_or_io_failure_exit": 1,
    "argument_failure_exit": 2,
    "failure_stdout": "empty",
    "failure_stderr": "one controlled message without traceback"
  }
}
